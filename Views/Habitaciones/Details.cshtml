@model Hotel.Web.Models.Habitacion
@{ ViewData["Title"] = "Detalle de habitación"; }
<div class="page-heading"><div><p class="eyebrow text-success">HABITACIÓN @Model.Numero</p><h1>Detalle de habitación</h1></div><div><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.IdHabitacion">Editar</a> <a class="btn btn-light" asp-action="Index">Volver</a></div></div>
<div class="card-clean p-4"><div class="row g-4"><div class="col-md-3"><span class="muted d-block small">Número</span><strong>@Model.Numero</strong></div><div class="col-md-3"><span class="muted d-block small">Piso</span><strong>@Model.Piso</strong></div><div class="col-md-3"><span class="muted d-block small">Tipo</span><strong>@Model.IdTipoHabitacionNavigation.Nombre</strong></div><div class="col-md-3"><span class="muted d-block small">Precio</span><strong>S/ @Model.IdTipoHabitacionNavigation.PrecioNoche.ToString("N2")</strong></div></div><hr /><a class="text-danger" asp-action="Delete" asp-route-id="@Model.IdHabitacion">Dar de baja</a></div>
