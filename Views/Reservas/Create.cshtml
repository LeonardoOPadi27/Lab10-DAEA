@model Hotel.Web.Models.Reserva
@{ ViewData["Title"] = "Nueva reserva"; }
<div class="page-heading"><div><p class="eyebrow text-success">NUEVA ESTANCIA</p><h1>Registrar reserva</h1><p class="muted mb-0">La reserva se registrará inicialmente como Pendiente.</p></div></div>
<div class="card-clean p-4"><form asp-action="Create"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-6"><label asp-for="IdHuesped" class="form-label">Huésped</label><select asp-for="IdHuesped" class="form-select" asp-items="ViewBag.Huespedes"><option value="">Selecciona un huésped</option></select><span asp-validation-for="IdHuesped" class="text-danger"></span></div><div class="col-md-6"><label asp-for="IdHabitacion" class="form-label">Habitación</label><select asp-for="IdHabitacion" class="form-select" asp-items="ViewBag.Habitaciones"><option value="">Selecciona una habitación</option></select><span asp-validation-for="IdHabitacion" class="text-danger"></span></div><div class="col-md-6"><label asp-for="FechaIngreso" class="form-label">Fecha de ingreso</label><input asp-for="FechaIngreso" type="date" class="form-control" /><span asp-validation-for="FechaIngreso" class="text-danger"></span></div><div class="col-md-6"><label asp-for="FechaSalida" class="form-label">Fecha de salida</label><input asp-for="FechaSalida" type="date" class="form-control" /><span asp-validation-for="FechaSalida" class="text-danger"></span></div><div class="col-12"><label asp-for="Observaciones" class="form-label">Observaciones</label><textarea asp-for="Observaciones" class="form-control" rows="3" maxlength="200" placeholder="Solicitud especial u observación opcional"></textarea><span asp-validation-for="Observaciones" class="text-danger"></span></div></div><div class="mt-4 d-flex gap-2"><button class="btn btn-primary">Registrar reserva</button><a class="btn btn-light" asp-action="Index">Cancelar</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
