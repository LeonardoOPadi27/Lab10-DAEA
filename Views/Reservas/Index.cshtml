@model IEnumerable<Hotel.Web.Models.Reserva>
@{ ViewData["Title"] = "Reservas"; }
<div class="page-heading"><div><p class="eyebrow text-success">HISTORIAL</p><h1>Reservas</h1><p class="muted mb-0">Control de estancias registradas.</p></div><a class="btn btn-primary" asp-action="Create">Nueva reserva</a></div>
<div class="card-clean table-responsive"><table class="table"><thead><tr><th>HUÉSPED</th><th>HABITACIÓN</th><th>ESTANCIA</th><th>ESTADO</th><th>TOTAL</th><th></th></tr></thead><tbody>@foreach (var item in Model) { var clase = item.Estado == "Cancelada" ? "badge-cancelled" : item.Estado == "Pendiente" ? "badge-pending" : "badge-soft"; var noches = item.FechaSalida.DayNumber - item.FechaIngreso.DayNumber; var total = noches * item.IdHabitacionNavigation.IdTipoHabitacionNavigation.PrecioNoche; <tr><td><strong>@item.IdHuespedNavigation.Apellidos, @item.IdHuespedNavigation.Nombres</strong><br /><small class="muted">@item.IdHuespedNavigation.Dni</small></td><td>@item.IdHabitacionNavigation.Numero</td><td>@item.FechaIngreso.ToString("dd/MM/yyyy")<br /><small class="muted">@noches noche(s)</small></td><td><span class="badge @clase rounded-pill">@item.Estado</span></td><td>S/ @total.ToString("N2")</td><td class="text-end">@if (item.Estado is "Pendiente" or "Confirmada") { <form asp-action="Cancelar" asp-route-id="@item.IdReserva" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Cancelar esta reserva?')">Cancelar</button></form> }</td></tr> }</tbody></table></div>
